# Copy this file to deploy.env and fill in your values.
# deploy.env is gitignored — never commit it.

# ── Airbyte VM ───────────────────────────────────────────────────────────────
AIRBYTE_VM_USER=your_ssh_user
AIRBYTE_VM_IP=x.x.x.x
AIRBYTE_SSH_KEY=$HOME/.ssh/your_key

# ── Kubernetes context inside the VM ────────────────────────────────────────
AIRBYTE_K8S_CONTROL_PLANE=airbyte-abctl-control-plane   # kind cluster container name
AIRBYTE_K8S_NAMESPACE=airbyte-abctl
AIRBYTE_DB_POD=airbyte-db-0

# ── GCP / Container Registry ─────────────────────────────────────────────────
GCP_PROJECT=your-gcp-project-id
GCP_REGISTRY_REGION=us-central1                          # region for Artifact Registry
GCP_REGISTRY_REPO=airbyte-connectors                    # Artifact Registry repo name

# ── Airbyte DB record IDs (from actor_definition_version table) ───────────────
# Find with: SELECT id, docker_image_tag FROM actor_definition_version WHERE docker_repository LIKE '%source-mssql-ct%';
MSSQL_CT_ACTOR_DEF_VERSION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Find with: SELECT id, docker_image_tag FROM actor_definition_version WHERE docker_repository LIKE '%source-mongodb%';
MONGODB_ACTOR_DEF_VERSION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
